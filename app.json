{
  "expo": {
    "name": "فكّرني — Remind Me",
    "slug": "fakarny-remind-me",
    "scheme": "fakarny",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FCFAF4",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.andrewmetry.fakarny",
      "infoPlist": {
        "CFBundleDisplayName": "فكّرني — Remind Me"
      }
    },
    "android": {
      "package": "com.andrewmetry.fakarny",
      "versionCode": 3,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#F4E9D3"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#245D48",
          "sounds": [
            "./assets/reminder.wav"
          ],
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Remind Me to use the microphone only when you tap the voice button. / اسمح لفكّرني باستخدام الميكروفون فقط عند الضغط على زر الإدخال الصوتي.",
          "speechRecognitionPermission": "Allow Remind Me to turn spoken shopping items into text. / اسمح لفكّرني بتحويل كلامك إلى نص لإضافة عناصر التسوق.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ]
  }
}